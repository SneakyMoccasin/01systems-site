          { "dimensionId": "stability", "direction": "decrease", "curveId": "exponential-response" },
          { "dimensionId": "output", "direction": "increase", "curveId": "logistic-response" }
        ]
      }
    ],
    "actions": [
      { "actionId": "adjust-alpha", "effects": [{ "driverId": "input-alpha", "delta": 0.1 }] },
      { "actionId": "adjust-beta", "effects": [{ "driverId": "input-beta", "delta": -0.1 }] }
    ],
    "propagation": {
      "edges": [{ "edgeId": "alpha-to-beta", "sourceDriverId": "input-alpha", "targetDriverId": "input-beta", "triggerLevelIds": ["high"], "propagatedLevelId": "high" }],
