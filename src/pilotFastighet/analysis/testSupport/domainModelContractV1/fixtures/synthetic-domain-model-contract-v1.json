      ]
    }],
    "drivers": [
      {
        "driverId": "input-alpha", "scaleId": "state", "initial": { "levelId": "low", "score": 0 },
        "numericRange": { "minimum": 0, "maximum": 1 }, "adverseLevelIds": ["high"],
        "impacts": [{ "dimensionId": "output", "direction": "increase", "curveId": "linear-response" }]
      },
      {
